{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "sql:allow-load",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-file",
    "fs:allow-temp-read",
    "fs:allow-temp-write",
    "shell:default"
  ]
}