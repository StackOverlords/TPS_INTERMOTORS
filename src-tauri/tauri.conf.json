{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TPS Intermotors",
  "version": "1.0.3",
  "identifier": "com.intermotors.tps",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TPS Intermotors",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/StackOverlords/TPS_INTERMOTORS/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4N0RCRUYzNzRBODAzQ0YKUldUUEE2aDA4NzU5T1B5K0JYQ1Brcy9hZVRhQzltNXRkWjIwTWl1Y3BJWE1HSXphSndWMWNpcU4K"
    },
    "sql": {
      "preload": ["sqlite:app.db"],
      "scope": {
        "allowed": ["sqlite:app.db"]
      }
    }
  }
}
